*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
#
# `.env*`, not `.env.*`. The dotted form requires a dot after `.env`, so
# `.env~` -- what vim, emacs and several editors write when they save --
# was not ignored. The ingestion repo learned this on 2026-09-09, when a
# `.env.bak-preconsolidation` holding real credentials sat un-ignored in
# the working tree. The same class of gap survived here, in the other
# repo, until 2026-09-13. Match the whole family; re-admit the template.
.env*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

