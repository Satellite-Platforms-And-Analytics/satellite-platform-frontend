# Supabase, anon key only.
#
# The anon key is safe in a browser *because* row-level security is on and
# 001_core_schema.sql grants only SELECT to anon ("Public read satellites").
# Never put the service_role key here - it bypasses RLS entirely.
#
# These are read server-side by app/api/tles/route.ts, so they are not
# NEXT_PUBLIC_*: the browser never sees them and never talks to Supabase
# directly. That keeps the query shape under our control and lets the API
# route cache.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
